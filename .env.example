# Provider: "ollama" or "openai-compatible"
NEXUS_PROVIDER=ollama

# Ollama API base URL
OLLAMA_HOST=http://127.0.0.1:11434

# OpenAI-compatible local server, e.g. LM Studio or llama.cpp server
NEXUS_OPENAI_COMPAT_HOST=http://127.0.0.1:1234/v1
# Optional. Keep private; do not commit a real key.
# NEXUS_OPENAI_COMPAT_API_KEY=

# Maximum number of model requests to run simultaneously (1-8)
NEXUS_MAX_WORKERS=2

# Fraction of available host memory used as a conservative planning budget (0.2-0.85)
NEXUS_MEMORY_BUDGET_FRACTION=0.60

# Maximum generated tokens per model response (1-32768)
NEXUS_MAX_OUTPUT_TOKENS=2048

# Per-request timeout in seconds (1-600)
NEXUS_REQUEST_TIMEOUT=120

# Optional path for the local SQLite state database
# NEXUS_STATE_PATH=~/.local/state/zoavintsoa-ai-nexus/state.sqlite3
